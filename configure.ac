#
# Autoconf & Automake startup
#

# Initialize Autoconf
AC_PREREQ(2.68)
AC_INIT([ABINIT-Fallbacks],[10.6],
  [https://bugs.launchpad.net/abinit-fallbacks/],[abinit-fallbacks])
AC_REVISION([Autotools support for the ABINIT Fallbacks])
AC_CONFIG_AUX_DIR([config/gnu])
AC_CONFIG_SRCDIR([.])
_AC_SRCDIRS(["."])

# ---------------------------------------------------------------------------- #

#
# Startup
#

# Initial setup
AC_CANONICAL_TARGET
AM_INIT_AUTOMAKE(1.12)

# Check for common programs
AC_PROG_MAKE_SET
AC_PROG_INSTALL
AC_PROG_LN_S
AC_PROG_SED
AC_PROG_AWK
AC_PROG_GREP

# Workaround for the "grep -e" issue on Solaris systems
AC_PROG_EGREP

# Workaround for the wrong path to install-sh on Mac systems
AX_PROG_MKDIR_P

# Make sure the source tree is complete
${MKDIR_P} sources stamps

# ---------------------------------------------------------------------------- #

#
# Define global options
#

# Manage environment variables and command-line options
AFB_ENV_BACKUP
AFB_OPTIONS_DEFINE
AFB_OPTIONS_BACKUP
AFB_OPTIONS_SETUP
AFB_OPTIONS_CHANGED
AFB_OPTIONS_PARSE
AFB_ENV_INIT

# set-up tarball directory
if test "${with_tardir}" = ""; then
  abinit_tardir="${HOME}/.abinit/tarballs"
else
  abinit_tardir="${with_tardir}"
fi
AC_MSG_NOTICE([setting tarball repository to ${abinit_tardir}])

# Make sure the tarball directory exists
if test ! -e "${abinit_tardir}"; then
  AC_MSG_NOTICE([creating tarball repository ${abinit_tardir}])
  ${INSTALL} -d -m 755 "${abinit_tardir}"
fi
AC_MSG_NOTICE([using tarball repository ${abinit_tardir}])

# Set-up installation directory
if test "${enable_local_build}" = "yes"; then
  AC_MSG_NOTICE([tuning install parameters for local build])
  prefix="${ac_abs_top_builddir}/exports"
fi

# Substitutions
AC_SUBST(abinit_tardir)

# ---------------------------------------------------------------------------- #

#
# Downloading support
#

# Look for wget and curl
if test "${WGET}" = ""; then
  AC_CHECK_PROGS([WGET],[wget])
fi
if test "${CURL}" = ""; then
  AC_CHECK_PROGS([CURL],[curl])
fi

# Warn if neither wget nor curl have been found
# Note: cannot stop, since tarballs may be downloaded by other means
if test "${WGET}" = "" -a "${CURL}" = ""; then
  AC_MSG_WARN([no downloader found
    Please set the WGET or CURL environment variable manually if
    you want to be able to download tarballs])
fi

# Select downloader and corresponding options
if test "${WGET}" != ""; then
  afb_downloader="${WGET}"
  afb_dlopts="--timeout=15 --tries=1 -q -O"
elif test "${CURL}" != ""; then
  afb_downloader="${CURL}"
  afb_dlopts="--connect-timeout 15 --retry 1 -s -S -o"
fi

# ---------------------------------------------------------------------------- #

#
# Source code management
#

# Make sure required patches can be applied
AFB_PATCHES_SETUP

# ---------------------------------------------------------------------------- #

#
# Compiler search order
#
# When CC/CXX/FC are not set by the user, prefer MPI wrappers over serial
# compilers (and Intel oneAPI over GNU), so that e.g. loading an Intel MPI
# toolchain is enough to get mpiicx/mpiicpx/mpiifx picked up automatically.
# Explicit CC=..., CXX=..., FC=... on the command line still take precedence.
#
m4_define([afb_cc_search_list],
  [mpiicx mpiicc mpicc icx icc gcc cc])
m4_define([afb_cxx_search_list],
  [mpiicpx mpiicpc mpicxx mpic++ mpiCC icpx icpc g++ c++])
m4_define([afb_fc_search_list],
  [mpiifx mpiifort mpif90 mpifort ifx ifort gfortran f95 f90])

# On a Cray Programming Environment, the cc/CC/ftn wrappers already include
# MPI (cray-mpich) and the selected PrgEnv compiler, so they must win over
# anything else. They cannot simply be put in the lists above, since "cc"
# and "CC" exist on most systems, hence the explicit detection.
AC_MSG_CHECKING([for a Cray Programming Environment])
afb_cray_pe="no"
if test "${CRAYPE_VERSION}" != "" -o "${PE_ENV}" != ""; then
  if command -v ftn >/dev/null 2>&1 && command -v cc >/dev/null 2>&1; then
    afb_cray_pe="yes"
  fi
fi
AC_MSG_RESULT([${afb_cray_pe}])
if test "${afb_cray_pe}" = "yes"; then
  test "${CC}" = "" && CC="cc"
  test "${CXX}" = "" && CXX="CC"
  test "${FC}" = "" && FC="ftn"
fi
# Whether the Fortran compiler is the Cray wrapper, which links Cray LibSci
# and MPICH automatically (it might not be, if FC has been set explicitly)
afb_cray_wrappers="no"
if test "${afb_cray_pe}" = "yes"; then
  tmp_fc_cmd=`echo ${FC} | cut -d' ' -f1`
  test "`basename ${tmp_fc_cmd}`" = "ftn" && afb_cray_wrappers="yes"
  unset tmp_fc_cmd
  if test "${afb_cray_wrappers}" = "yes"; then
    AC_MSG_NOTICE([using Cray compiler wrappers: CC=${CC} CXX=${CXX} FC=${FC}])
  else
    AC_MSG_NOTICE([not using the Cray compiler wrappers, as requested: CC=${CC} CXX=${CXX} FC=${FC}])
  fi
fi

# ---------------------------------------------------------------------------- #

#
# C support
#

AC_PROG_CC(afb_cc_search_list)
AC_PROG_CPP

# Detect MPI support like arch-mpi from the main ABINIT tree
# Instead of guessing from the wrapper name, try compiling tiny MPI programs.
has_mpi="no"
afb_mpi_cc_ok="no"
afb_mpi_fc_ok="no"
afb_has_mpi="no"
ac_cc_req=${CC}
AFB_MPI_CHECK_CC
tmp_cc=$(echo "${CC}"|grep -o '[[^/]]*$')
if test "${afb_mpi_cc_ok}" = "yes"; then
  # If CC is an MPI wrapper, try to recover the underlying compiler
  if test "mpi" = $(echo "${tmp_cc}"|cut -c -3); then
    ac_cc_req=$(eval $ac_cc_req -show 2>/dev/null |cut -d' ' -f1)
    if test "x${ac_cc_req}" = "x"; then
      ac_cc_req=${CC}
    fi
  fi
else
  AC_MSG_WARN([C compiler failed to link a simple MPI program; MPI fallbacks will stay disabled])
fi

# LibXC sometimes requires C99
# Note: if problem, set ac_cv_prog_cc_c99="no"
#AC_PROG_CC_C99 is obsolete starting from autoconf 2.70 
AC_PROG_CC(afb_cc_search_list)

# Store information on C compiler
AFB_PROG_CC(${CC})
ref_cc_vendor="${afb_cc_vendor}"
ref_cc_version="${afb_cc_version}"
ref_cc_cmd="${ac_cc_req}"

# ---------------------------------------------------------------------------- #

#
# C++ support
#

AC_PROG_CXX(afb_cxx_search_list)

# ---------------------------------------------------------------------------- #

#
# Fortran support
#

AC_PROG_FC(afb_fc_search_list)

# AC_PROG_FC does not check that the Fortran compiler works, since Autoconf
# only does it for the first compiler (C). A broken one, e.g. an MPI wrapper
# around a compiler missing from the PATH, would otherwise silently disable
# MPI, ELPA and the vendor-specific detection of linear algebra (e.g. MKL)
AC_MSG_CHECKING([whether the Fortran compiler works])
AC_LANG_PUSH([Fortran])
AC_LINK_IFELSE([AC_LANG_PROGRAM([], [])], [afb_fc_ok="yes"], [afb_fc_ok="no"])
AC_LANG_POP([Fortran])
AC_MSG_RESULT([${afb_fc_ok}])
if test "${afb_fc_ok}" != "yes"; then
  AC_MSG_FAILURE([the Fortran compiler '${FC}' cannot create executables])
fi

AFB_MPI_CHECK_FC
if test "${afb_mpi_fc_ok}" != "yes"; then
  AC_MSG_WARN([Fortran compiler failed to link a simple MPI program; MPI fallbacks will stay disabled])
fi
if test "${afb_mpi_cc_ok}" = "yes" -a "${afb_mpi_fc_ok}" = "yes"; then
  afb_has_mpi="yes"
fi
AFB_PROG_FC

# Cray Fortran names module files MODULENAME.mod (uppercase) by default,
# while the fallbacks (e.g. netcdf-fortran) install them as modulename.mod;
# -ef makes the compiler write lowercase module file names
if test "${afb_fc_vendor}" = "cray"; then
  AC_MSG_NOTICE([Cray Fortran: adding -ef to get lowercase module file names])
  FCFLAGS_FREEFORM="${FCFLAGS_FREEFORM} -ef"
fi

# ---------------------------------------------------------------------------- #

#
# Archiver support
#

AC_CHECK_PROGS([AR],[ar xiar])
AC_PROG_RANLIB

# ---------------------------------------------------------------------------- #

#
# Final build parameters configuration
#

# Make use of *_EXTRA flags
ARFLAGS="${ARFLAGS} ${ARFLAGS_EXTRA}"
CC_LDFLAGS="${CC_LDFLAGS} ${CC_LDFLAGS_EXTRA}"
CFLAGS="${CFLAGS} ${CFLAGS_EXTRA}"
CFGFLAGS="${CFGFLAGS} ${CFGFLAGS_EXTRA}"
CPPFLAGS="${CPPFLAGS} ${CPPFLAGS_EXTRA}"
CXX_LDFLAGS="${CXX_LDFLAGS} ${CXX_LDFLAGS_EXTRA}"
CXXFLAGS="${CXXFLAGS} ${CXXFLAGS_EXTRA}"
FC_LDFLAGS="${FC_LDFLAGS} ${FC_LDFLAGS_EXTRA}"
FCFLAGS="${FCFLAGS} ${FCFLAGS_EXTRA}"
FPPFLAGS="${FPPFLAGS} ${FPPFLAGS_EXTRA}"
XPPFLAGS="${XPPFLAGS} ${XPPFLAGS_EXTRA}"

# Merge-in *LIBS flags
CC_LIBS="${CC_LIBS} ${LIBS}"
CXX_LIBS="${CXX_LIBS} ${LIBS}"
FC_LIBS="${FC_LIBS} ${LIBS}"

# ---------------------------------------------------------------------------- #

#
# Configure fallbacks and their dependencies in the correct order
#

# HDF5 significantly enhances NetCDF4
# but we should allow fallback without hdf5
# enable_hdf5="yes"
afb_hdf5_build_par="no"

if test "${afb_has_mpi}" = "yes"; then
   afb_hdf5_build_par="yes"
   AC_MSG_NOTICE([
Building the HDF5 parallel version... ${afb_hdf5_build_par}
   ])
fi

# Check that the NetCDF4 compiler wrapper is the same as our current compiler
if test "${CC_NETCDF4}" = ""; then
  CC_NETCDF4="${CC}"
fi
AFB_PROG_CC(${CC_NETCDF4})
if test "${afb_cc_vendor}" != "${ref_cc_vendor}"; then
  AC_MSG_WARN([NetCDF4 will be built with a different C compiler
                    The build of Abinit might fail])
else
  if test "${afb_cc_version}" != "${ref_cc_version}"; then
    AC_MSG_WARN([NetCDF4 will be built with a different compiler version])
  fi
fi

# Look for external linear algebra as Abinit does
AFB_LINALG_DETECT

# ELPA requires MPI (and ScaLAPACK): do not build it by default without MPI
if test "${afb_has_mpi}" != "yes" -a "${enable_elpa}" = ""; then
  AC_MSG_NOTICE([MPI is not available => disabling the ELPA fallback])
  enable_elpa="no"
fi

# Configure all fallbacks
AFB_SETUP_PACKAGES

# Extra dependency checks for netcdf4_fortran
AX_CHECK_ZLIB
AX_CHECK_SZIP
AX_CHECK_CURL

# ---------------------------------------------------------------------------- #

#
# Output configuration and report
#

AC_CONFIG_COMMANDS([script-perms],
  [chmod u+x src/abinit-fallbacks-config src/install-symlinks.sh])

AC_CONFIG_FILES([
  Makefile
  fallbacks.dump
  src/abinit-fallbacks-config
  src/install-symlinks.sh
  src/Makefile])
AC_OUTPUT

AFB_INFO_DISPLAY
