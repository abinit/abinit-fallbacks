Fix the declaration of elpa_solve_tridiagonal_{dc,fc}_c

In the complex case, the subroutine statement ends with a continuation "&"
followed by a line containing only "& !bind(C, ...)", i.e. a continuation
line without any text. GNU and Intel compilers accept it, but Cray Fortran
(ftn-71) rejects it, which makes the whole elpa_impl module fail to compile.
Only put the trailing "&" in the real case, where bind(C) actually follows.

--- a/src/elpa_impl_math_template.F90
+++ b/src/elpa_impl_math_template.F90
@@ -1165,8 +1165,8 @@
 
     subroutine elpa_solve_tridiagonal_&
                     &ELPA_IMPL_SUFFIX&
-                    &_c(handle, d_p, e_p, q_p, error) &
 #ifdef REALCASE
+                    &_c(handle, d_p, e_p, q_p, error) &
 #ifdef DOUBLE_PRECISION_REAL
                     bind(C, name="elpa_solve_tridiagonal_d")
 #endif
@@ -1175,11 +1175,12 @@
 #endif
 #endif
 #ifdef COMPLEXCASE
+                    &_c(handle, d_p, e_p, q_p, error)
 #ifdef DOUBLE_PRECISION_COMPLEX
-                    & !bind(C, name="elpa_solve_tridiagonal_dc")
+                    !bind(C, name="elpa_solve_tridiagonal_dc")
 #endif
 #ifdef SINGLE_PRECISION_COMPLEX
-                    & !bind(C, name="elpa_solve_tridiagonal_fc")
+                    !bind(C, name="elpa_solve_tridiagonal_fc")
 #endif
 #endif
 
